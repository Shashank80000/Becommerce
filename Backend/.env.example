PORT=5000
# Copy the complete Node.js driver URI from MongoDB Atlas. Use a URL-encoded password.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/cleaning_products?retryWrites=true&w=majority
# Exact Vercel frontend origin(s), comma-separated. Do not add a trailing slash or /api.
CLIENT_URL=http://localhost:5173
ADMIN_API_KEY=replace_with_a_long_random_secret
NODE_ENV=development
